{
  // Typecheck config: the whole repository, tests included, nothing emitted.
  // `rootDir` is deliberately absent — setting it here makes `tsc --noEmit` fail with
  // TS6059 on every file under tests/ (see .claude/ledger.md, Known Pitfalls).
  // Emit settings live in tsconfig.build.json, which extends this file.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
