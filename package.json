{
  "name": "chronicle-mcp",
  "version": "0.4.0",
  "description": "Cross-project AI memory MCP server with six cognitive memory types, token-gated team coordination + knowledge sharing, and agent-instructive tool descriptions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chronicle-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "dashboard": "tsx src/cli.ts --dashboard",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "ai",
    "memory",
    "claude",
    "copilot",
    "cursor"
  ],
  "author": "Juan Carlos Ghiringhelli",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/jghiringhelli/chronicle-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jghiringhelli/chronicle-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jghiringhelli/chronicle-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "fastembed": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
